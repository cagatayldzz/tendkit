{
  "name": "tendkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bash scripts/build-app.sh release",
    "update": "cargo update",
    "check": "bash scripts/tests/run.sh && cargo fmt --all -- --check && cargo clippy --locked --workspace --all-targets -- -D warnings && bash scripts/test.sh",
    "test": "bash scripts/tests/run.sh && bash scripts/test.sh",
    "icons": "bash scripts/make-icns.sh",
    "commit": "git add -A && oco --yes",
    "release": "bash scripts/release.sh"
  }
}
